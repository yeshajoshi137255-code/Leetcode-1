class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int count = 0;
        int answer = nums[0];
        for(int i = 0; i < nums.size(); i++)
        {
            if(nums[i] == answer)
            {
                count++;
            }
            else
            {
                count--;
            }
            if(count == 0)
            {
                answer = nums[i];
                count = 1;
            }
        }
        return answer;
    }
};
